# Example only: the installer refuses these placeholder hostnames.
NEEDLETAIL_OPS_LISTEN=127.0.0.1:19449
NEEDLETAIL_OPS_ASSIGNMENT_FILE=/run/needletail/operations-collector.json
NEEDLETAIL_OPS_AUTHORITY=needletail-controller
NEEDLETAIL_OPS_ENTRYPOINT_HOST=ops.example.com
NEEDLETAIL_OPS_ALLOWED_ENDPOINTS=https://ops-eu.example.com/mesh,https://ops-apac.example.com/mesh
NEEDLETAIL_OPS_LEASE_SAFETY_MARGIN_MS=5000
NEEDLETAIL_OPS_MAX_CLOCK_SKEW_MS=1000
NEEDLETAIL_OPS_MAX_LEASE_DURATION_MS=30000
NEEDLETAIL_OPS_MAX_CONNECTIONS=128
