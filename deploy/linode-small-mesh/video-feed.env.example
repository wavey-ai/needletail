# Example only (needletail-video-feed.service): the contributors' VLAN
# addresses, the origin first, and ffmpeg's arguments, in which {host} is the
# address of the contributor the feed is on (one output; a ladder has one an
# output, each with {host}).
FEED_CONTRIBUTORS=10.77.1.5 10.77.1.7
FEED_ARGUMENTS=-hide_banner -loglevel error -nostdin -re -probesize 64M -analyzeduration 10000000 -stream_loop -1 -i /var/lib/needletail/feed.ts -map 0:v:0 -map 0:a:0 -c copy -muxdelay 0 -muxpreload 0 -f mpegts srt://{host}:27001?mode=caller&transtype=live&latency=80
