# Copy to /etc/needletail/quadra.env with mode 0600. Do not commit real
# addresses, credentials, certificates, or provider data.
NEEDLETAIL_NODE_ID=contrib-quadra-london
NEEDLETAIL_QUADRA_RIST_BIND=0.0.0.0:27000
NEEDLETAIL_QUADRA_SOURCE_STREAM_ID=9001
NEEDLETAIL_QUADRA_SOURCE_WIDTH=3840
NEEDLETAIL_QUADRA_SOURCE_HEIGHT=2160
NEEDLETAIL_QUADRA_FRAME_RATE_MILLIHERTZ=25000
NEEDLETAIL_QUADRA_QUEUE_CAPACITY=256
NEEDLETAIL_QUADRA_RENDITIONS=101:1920x1080:7000000:8000000,102:1280x720:3500000:4000000,103:854x480:1500000:2000000
NEEDLETAIL_QUADRA_MESH_FEC_TARGET=REPLACE_WITH_PRIVATE_MESH_IP:22001
NEEDLETAIL_QUADRA_MESH_MEDIA_FEC_TARGET=REPLACE_WITH_PRIVATE_MESH_IP:22101

# For the normal dual-parent RelaySession path, populate the same compiled
# route fields used by other contributors.
# AV_RELAY_PRIMARY_TARGET=REPLACE_WITH_PRIMARY_RELAY_IP:29001
# AV_RELAY_PRIMARY_BIND=0.0.0.0:29201
# AV_RELAY_PRIMARY_ID=relay-primary-amsterdam
# AV_RELAY_SECONDARY_TARGET=REPLACE_WITH_SECONDARY_RELAY_IP:29002
# AV_RELAY_SECONDARY_BIND=0.0.0.0:29202
# AV_RELAY_SECONDARY_ID=relay-secondary-japan
# AV_RELAY_SECONDARY_SEED_SOURCE=true
# AV_RELAY_EXCLUSIVE=true
